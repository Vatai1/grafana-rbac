# cp .env.example .env && chmod 600 .env, then fill in. Never commit .env.
DOMAIN=grafana.example.com          # DNS A-record must point to this server (ports 80/443 open) for Let's Encrypt
GRAFANA_TAG=13.2.4-e2af5438         # pin a tag from https://hub.docker.com/r/vatai12/grafana-rbac/tags
GF_ADMIN_PASSWORD=                  # openssl rand -base64 24; applied on the first start only
POSTGRES_PASSWORD=                  # openssl rand -base64 24
BACKUP_KEEP_DAYS=14
